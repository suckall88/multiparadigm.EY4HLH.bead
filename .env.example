# Copy this file to .env and fill in real values. Never commit the real .env.
# On Render / Streamlit Community Cloud set these in the provider's own
# environment/secrets settings instead.

# ---- Backend ---------------------------------------------------------------
DATABASE_URL=sqlite:///./dev.db
MAINTENANCE_TOKEN=changeme
LOG_LEVEL=INFO
# Set to true only by the maintenance program during a DB swap (on Render).
WRITES_FROZEN=false

# ---- Frontend --------------------------------------------------------------
BACKEND_URL=http://localhost:8000

# ---- Maintenance / DB-swap control program ------------------------------------
# Render API access and the resources it may manage.
RENDER_API_KEY=changeme
RENDER_OWNER_ID=changeme
RENDER_WEB_SERVICE_ID=changeme
# The Render Postgres instance currently used by the backend (first run only;
# afterwards the program tracks the active instance in maintenance/state/).
ACTIVE_DB_INSTANCE_ID=changeme
# Empty local Postgres database used for the practice restore before the old
# instance is deleted. Must be the same major version family as the source.
REHEARSAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edzesnaplo_rehearsal
# Prior authorization: without "true" the program only checks and logs.
MAINTENANCE_SWAP_ENABLED=false
CHECK_INTERVAL_SECONDS=3600
EXPIRY_WARNING_DAYS=3
# Planned maintenance time (ISO 8601). Without an offset it is read in TIMEZONE.
MAINTENANCE_AT=
TIMEZONE=Europe/Budapest
# Explicit parameters of the new instance.
TARGET_DB_PLAN=free
TARGET_DB_REGION=frankfurt
TARGET_DB_VERSION=16
# Seconds to wait for in-flight writes after freezing, before the final backup.
WRITE_DRAIN_SECONDS=5
